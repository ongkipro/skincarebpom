---
import { getStoreAdsConfig } from '../../../lib/store-ads';
import { META_EXTERNAL_ID_COOKIE } from '../../../lib/click-ids';

interface Props {
  pixelId?: string;
}

const { pixelId: pixelIdProp } = Astro.props;

let pixelId = pixelIdProp;
if (pixelId === undefined) {
  const adsConfig = await getStoreAdsConfig(Astro.locals);
  pixelId = adsConfig.metaPixelId;
}
const shouldRenderPixel = /^\d{5,25}$/.test(String(pixelId || '').trim());
---

{shouldRenderPixel && (
  <>
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <script is:inline define:vars={{ pixelId, metaExternalIdCookie: META_EXTERNAL_ID_COOKIE }}>
      // 1. Synchronously create Meta Pixel stub and inject script loader immediately
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        if (s && s.parentNode) {
          s.parentNode.insertBefore(t, s);
        } else {
          b.head.appendChild(t);
        }
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      var readMetaCookie = function (name) {
        var match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
        return match ? match[3] : '';
      };

      var externalId = readMetaCookie(metaExternalIdCookie);
      if (!/^[a-f0-9]{32}$/.test(externalId)) {
        try {
          externalId = Array.from(crypto.getRandomValues(new Uint8Array(16)))
            .map(function (byte) { return byte.toString(16).padStart(2, '0'); })
            .join('');
        } catch (e) {
          externalId = '';
        }
        if (externalId) {
          var cookieSecurity = window.location.protocol === 'https:' ? 'SameSite=None; Secure' : 'SameSite=Lax';
          document.cookie = metaExternalIdCookie + '=' + externalId + '; Path=/; Max-Age=7776000; ' + cookieSecurity;
        }
      }

      var createPvEventId = function (prefix) {
        return prefix + '_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
      };
      var eventId = createPvEventId('pv');

      window.__META_PAGEVIEW_EVENT_ID__ = eventId;
      window.__META_PIXEL_ID__ = pixelId;

      void (async function () {
        var externalIdHash;
        if (externalId && typeof crypto !== 'undefined' && crypto.subtle) {
          try {
            var digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(externalId));
            externalIdHash = Array.from(new Uint8Array(digest))
              .map(function (byte) { return byte.toString(16).padStart(2, '0'); })
              .join('');
          } catch (e) {}
        }

        if (externalIdHash) {
          window.fbq('init', pixelId, { external_id: externalIdHash });
        } else {
          window.fbq('init', pixelId);
        }
        window.fbq('track', 'PageView', {}, { eventID: eventId });
      })();
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${encodeURIComponent(pixelId)}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  </>
)}
